# ── PyPI (asimtool) — KOPYA BU DOSYAYI .env OLARAK DOLDUR, .env COMMIT EDİLMEZ ──
# API token'larında kullanıcı adı "__token__" olur (twine varsayılanı da öyle).
# Token üret: https://pypi.org/manage/account/token/
PYPI_USERNAME=__token__
PYPI_REPOSITORY=pypi
PYPI_TOKEN=pypi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Gerçek PyPI hesap adı (bilgi amaçlı, yayınlarda kullanılmaz)
PYPI_ACCOUNT=kullanici-adi
PYPI_PACKAGE=asimtool

# Hesap parolası. NOT: PyPI parola ile yüklemeyi desteklemiyor (HTTP 403),
# varsayılan akış PYPI_TOKEN kullanır. Alan ilerideki ihtiyaçlar için duruyor.
PYPI_PASSWORD=
